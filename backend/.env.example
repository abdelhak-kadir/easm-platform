# ── Required ──────────────────────────────────────────────────────────
# PostgreSQL connection
DATABASE_URL=postgresql://easm:easm@postgres:5432/easm

# Redis (Celery broker + result backend)
REDIS_URL=redis://redis:6379/0

# Optional but STRONGLY recommended — tools will fail or return no data
# without these keys.  See README.md for sign-up links.

# ── Recon API Keys ───────────────────────────────────────────────────
SHODAN_API_KEY=your-shodan-key-here          # https://developer.shodan.io
CENSYS_API_ID=your-censys-id-here            # https://search.censys.io/account/api
CENSYS_API_SECRET=your-censys-secret-here    # https://search.censys.io/account/api
MERKLEMAP_API_KEY=your-merklemap-key-here    # https://api.merklemap.com
PUBLICWWW_API_KEY=your-publicwww-key-here    # https://publicwww.com/profile
CERTSPOTTER_API_KEY=your-certspotter-key     # https://sslmate.com/certspotter/api (optional, higher limits)

# ── Optional ─────────────────────────────────────────────────────────
# Pass to tools that accept a free API key for higher rate limits
CHAOS_API_KEY=                                # https://chaos.projectdiscovery.io
LEAKIX_API_KEY=                               # https://leakix.net
ZOOMEYE_API_KEY=                              # https://www.zoomeye.org
